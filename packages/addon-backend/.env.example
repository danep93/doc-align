# Your static ngrok domain (find at https://dashboard.ngrok.com/domains)
NGROK_URL=your-domain.ngrok-free.app
BASE_URL=https://your-domain.ngrok-free.app

# Your @docalign.app email — used as your identity when OIDC_BYPASS=true (local dev only)
DEBUG_EMAIL=your-name@docalign.app

FIREBASE_PROJECT_ID=docalign-prod
PORT=8080
OIDC_BYPASS=true

# Optional: overrides Firestore config/secrets.resendApiKey
# RESEND_API_KEY=re_xxx
