      "logoUrl": "https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png",
      "homepageTrigger": {
        "runFunction": "https://reactor-explore-crumb.ngrok-free.dev/addon/homepage"
      }
    },
    "docs": {
      "homepageTrigger": {
        "runFunction": "https://reactor-explore-crumb.ngrok-free.dev/addon/homepage"
      },
      "onFileScopeGrantedTrigger": {
        "runFunction": "https://reactor-explore-crumb.ngrok-free.dev/addon/on-file-scope-granted"
      }
    },
    "gmail": {
      "contextualTriggers": [
        {
          "unconditional": {},
          "onTriggerFunction": "https://reactor-explore-crumb.ngrok-free.dev/addon/gmail-trigger"
        }
      ]
    }
  }
