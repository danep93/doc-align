{
  "name": "doc-align",
  "version": "0.1.0",
  "private": true,
  "description": "Sign-off and alignment platform for Google Docs",
  "scripts": {
    "build-all": "pnpm -r run build",
    "test-all": "pnpm -r run test",
    "test:e2e": "pnpm --filter @doc-align/e2e run test",
    "test:e2e:headed": "pnpm --filter @doc-align/e2e run test:headed",
    "test:e2e:save-auth": "pnpm --filter @doc-align/e2e run save-auth",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "deploy:staging": "pnpm run build-all && gcloud run deploy doc-align-api --source packages/backend --project doc-align-staging --region us-central1 --allow-unauthenticated",
    "deploy:prod": "pnpm run build-all && gcloud run deploy doc-align-api --source packages/backend --project doc-align --region us-central1 --allow-unauthenticated",
    "deploy:indexes:staging": "firebase deploy --only firestore:indexes --project doc-align-staging",
    "deploy:indexes:prod": "firebase deploy --only firestore:indexes --project doc-align",
    "build:extension:staging": "API_BASE=https://doc-align-api-staging.run.app/api FIREBASE_PROJECT_ID=doc-align-staging pnpm --filter @doc-align/extension run build",
    "build:extension:prod": "API_BASE=https://doc-align-api.run.app/api FIREBASE_PROJECT_ID=doc-align pnpm --filter @doc-align/extension run build"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4"
}
